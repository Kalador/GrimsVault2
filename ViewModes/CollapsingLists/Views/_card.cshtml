@model Vault.Core.Internal.PageContentItem
@using Vault.Core.Internal

<tr class="pc-row @(Model.HasError ? "is-excluded" : "")">

    <!-- Checkbox column -->
    <td class="col-select">
        @foreach (var el in Model.Elements.Where(e => e.Type == PageContentElementType.Checkbox))
        {
            <input type="checkbox"
                   name="@el.Name"
            @(el.Checked ? "checked" : "") />
        }
    </td>

    <!-- Thumbnail -->
    <td class="col-thumb">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="thumb vault-thumb" />
        }
    </td>

    <!-- Main text + meta -->
    <td class="col-main">
        <div class="main-line">@Html.Raw(Model.Primary)</div>

        <div class="meta-line">
            @if (!string.IsNullOrWhiteSpace(Model.Secondary))
            {
                <span class="meta-secondary">@Html.Raw(Model.Secondary)</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Ticker))
            {
                <span class="meta-tertiary">@Html.Raw(Model.Ticker)</span>
            }
        </div>
    </td>

    <!-- Value column -->
    <td class="col-value">
        @if (!string.IsNullOrWhiteSpace(Model.SecondFooter))
        {
            <span class="value-display">@Html.Raw(Model.SecondFooter)</span>
        }
    </td>

    <!-- Actions -->
    <td class="col-actions">
        @if (!string.IsNullOrWhiteSpace(Model.Url))
        {
            <a class="btn secondary btn-small"
               href="@Model.Url"
               target="_blank">View</a>
        }

        @foreach (var el in Model.Elements.Where(e => e.Type == PageContentElementType.Hidden))
        {
            <input type="hidden" name="@el.Name" value="@el.Value" />
        }
    </td>

</tr>
