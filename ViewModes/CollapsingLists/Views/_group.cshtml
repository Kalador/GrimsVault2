@model IGrouping<string, Vault.Core.Internal.PageContentItem>
@using Vault.Core.Internal

@{
    var groupName = Model.Key;
    var items = Model.ToList();
    var parentModel = ViewData["PageContentModel"] as PageContentModel;
}

<section class="collapsing-group">

    <!-- Group Header (clickable) -->
    <header class="collapsing-header vault-tight">
        <span class="collapsing-toggle-icon">▼</span>
        <span class="collapsing-title">@groupName</span>
        <span class="collapsing-count">(@items.Count)</span>
    </header>

    <!-- Group Body -->
    <div class="collapsing-body expanded">

        <div class="divider"></div>

        <!-- Exclusion form -->
        <form method="post" action="/ebay/exclude" class="exclude-form">

            <!-- Hidden fields -->
            <input type="hidden" name="ItemId" value="@items.First().Meta["itemId"]" />
            <input type="hidden" name="GroupName" value="@groupName" />

            <table class="pc-table">
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr class="pc-row @(item.HasError ? "is-excluded hidden" : "")">

                            <!-- NO bulk checkbox here -->
                            <!-- The ONLY checkbox is the one inside _Card.cshtml -->
                            @await Html.PartialAsync("/ViewModes/CollapsingLists/Views/_Card.cshtml", item)
                        </tr>
                    }
                </tbody>
            </table>

            @if (parentModel?.GroupButtons?.TryGetValue(groupName, out var groupButtons) == true &&
                 groupButtons.Any())
            {
                <div class="collapsing-group-actions">
                    @foreach (var btn in groupButtons)
                    {
                        if (btn.ActionUrl.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn"
                                    onclick="@btn.ActionUrl.Substring("javascript:".Length)">
                                @btn.Text
                            </button>

                        }
                        else
                        {
                            <button class="btn">@btn.Text</button>
                        }
                    }
                </div>
            }

        </form>

    </div>

</section>
