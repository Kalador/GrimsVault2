@model Vault.Core.Internal.PageContentModel
@using Vault.Core.Internal

@{
    var grouped = Model.Items
        .GroupBy(i => i.Group ?? "")
        .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="vault-page container-narrow">

    <!-- Shared 2.0 Header -->
    <div class="vault-header">
        @if (Model.Meta.TryGetValue("Title", out var titleObj) && titleObj is string title)
        {
            <h2 class="vault-title">@Html.Raw(title)</h2>
        }

        @if (Model.Meta.TryGetValue("Subtitle", out var subObj) && subObj is string subtitle)
        {
            <h2 class="vault-subtitle">@Html.Raw(subtitle)</h2>
        }

        @if (Model.PageButtons?.Any() == true)
        {
            <div class="vault-pagebuttons">
                @foreach (var btn in Model.PageButtons)
                {
                    <form method="post" action="@btn.ActionUrl" class="vault-pagebutton-form">
                        <button class="btn">@btn.Text</button>
                    </form>
                }
            </div>
        }
    </div>

    <!-- Shared 2.0 Inputs -->
    @if (Model.Inputs?.Any() == true)
    {
        <div class="vault-inputs">
            @foreach (var input in Model.Inputs)
            {
                <div class="vault-input">
                    @if (!string.IsNullOrWhiteSpace(input.Label))
                    {
                        <label for="@input.Name">@input.Label</label>
                    }

                    <input type="@input.Type"
                           id="@input.Name"
                           name="@input.Name"
                           value="@input.Value" />
                </div>
            }
        </div>
    }

    <!-- Collapsing Groups -->
    <div class="collapsinglists">

        @foreach (var group in grouped)
        {
            var groupName = group.Key;
            var items = group.ToList();

            <section class="collapsing-group">

                <!-- Group Header (clickable) -->
                <header class="collapsing-header vault-tight">
                    <span class="collapsing-toggle-icon">▼</span>
                    <span class="collapsing-title">@groupName</span>
                    <span class="collapsing-count">(@items.Count)</span>
                </header>

                <!-- Group Body -->
                <div class="collapsing-body expanded">

                    <div class="divider"></div>

                    <table class="pc-table">
                        <tbody>
                            @foreach (var item in items)
                            {
                                @await Html.PartialAsync("/ViewModes/CollapsingLists/Views/_Card.cshtml", item)
                            }
                        </tbody>
                    </table>

                    @if (Model.GroupButtons?.TryGetValue(groupName, out var groupButtons) == true &&
                         groupButtons.Any())
                    {
                        <div class="collapsing-group-actions">
                            @foreach (var btn in groupButtons)
                            {
                                <form method="post" action="@btn.ActionUrl">
                                    <button class="btn">@btn.Text</button>
                                </form>
                            }
                        </div>
                    }

                </div>

            </section>
        }

    </div>

</div>
