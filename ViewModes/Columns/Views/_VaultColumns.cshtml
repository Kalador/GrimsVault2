@model Vault.Core.Internal.PageContentModel
<link rel="stylesheet" href="/ViewModes/Columns/css/vault-columns.css" />


<div class="columns">
    @foreach (var group in Model.Items.GroupBy(i => i.Group))
    {
        <div class="column" data-group="@group.Key">
            <div class="column-header">@group.Key</div>

            @foreach (var item in group)
            {
                @await Html.PartialAsync("_VaultCard.cshtml", item)
            }
        </div>
    }
</div>

