@model Vault.Core.Internal.PageContentItem

@{
    var id = Model.Meta.ContainsKey("id") ? Model.Meta["id"]?.ToString() : "";
    var category = Model.Meta.ContainsKey("category") ? Model.Meta["category"]?.ToString() : "";
    var error = Model.Meta.ContainsKey("error") && (bool)Model.Meta["error"];
}

@if (!error)
{
    <a class="card-link" href="@Model.Url" target="_blank">
        <div class="column-card compact"
             data-id="@id"
             data-category="@category">

            <div style="display:flex; gap:1rem; align-items:flex-start;">

                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Title" style="height:80px; border-radius:6px;" />
                    }
                    else
                    {
                        <div class="text-muted" style="width:80px; height:80px; background:#eee;
                            display:flex; align-items:center; justify-content:center; border-radius:6px;">
                            No Image
                        </div>
                    }
                </div>

                <div style="flex:1; display:flex; flex-direction:column;">

                    <div class="column-card-title ticker">
                        <div class="ticker-content">
                            @Model.Title
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                    {
                        <div class="meta" style="font-size:1.4rem; font-weight:700;">
                            @Model.Subtitle
                        </div>
                    }

                    <div class="column-row">
                        <div class="meta ticker column-row-ticker">
                            <div class="ticker-content">
                                @Model.Footer
                            </div>
                        </div>

                        <div class="column-row-footer">
                            <span class="column-footer-item"></span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </a>
}
else
{
    <div class="column-card compact column-retry-card" data-id="@id" style="cursor:pointer;">
        <div style="display:flex; gap:1rem; align-items:flex-start;">

            <div>
                <div class="text-muted" style="width:80px; height:80px; background:#eee;
                    display:flex; align-items:center; justify-content:center; border-radius:6px;">
                    No Image
                </div>
            </div>

            <div style="flex:1;">
                <div class="column-card-title">Error. Click to Retry</div>

                <div class="meta" style="font-size:1.4rem; font-weight:700;">
                    @Model.Subtitle
                </div>
            </div>

        </div>
    </div>
}
