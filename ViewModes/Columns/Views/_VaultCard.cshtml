@model Vault.Core.Internal.PageContentItem

@if (!Model.HasError)
{
    <a class="card-link" href="@Model.Url" target="_blank">
        <div class="column-card"
             data-id="@Model.Meta.GetValueOrDefault("id")"
             data-group="@Model.Group">

            <div class="column-card-inner">

                <!-- Image -->
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             style="height:80px; width:auto; border-radius:6px; display:block;" />
                    }
                    else
                    {
                        <div class="column-card-noimage">
                            No Image
                        </div>
                    }
                </div>

                <!-- Content -->
                <div class="column-card-content">

                    <div class="column-card-title">
                        <div class="ticker column-card-title-ticker">
                            <div class="ticker-content">
                                @Model.Title
                            </div>
                        </div>
                    </div>

                    <div class="column-card-subtitle">
                        @Model.Subtitle
                    </div>

                    <div class="column-card-footer">
                        <div class="ticker">
                            <div class="ticker-content">
                                @Html.Raw(Model.Ticker)
                            </div>
                        </div>

                        <div class="column-card-timestamp">
                            @Model.SecondFooter
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </a>
}
else
{
    <a class="card-link retry"
               href="javascript:void(0)"
               onclick="retryCard('@Model.Meta.GetValueOrDefault("id")')">



        <div class="column-card error"
             data-id="@Model.Meta.GetValueOrDefault("id")">

            <div class="column-card-inner">

                <div class="column-card-noimage">
                    No Image
                </div>

                <div class="column-card-content">
                    <div class="column-card-error-message">
                        Error.<br /> Click to Retry
                    </div>
                </div>

            </div>

        </div>
    </a>

}
